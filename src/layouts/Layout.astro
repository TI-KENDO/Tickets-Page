---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ClientRouter } from 'astro:transitions';

export interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
}

const {
  title,
  description = 'Kendodesk es la plataforma de helpdesk y gestión de tickets ideal para centralizar el soporte de TI de tu empresa, mejorar tiempos de respuesta y satisfacción de usuarios.',
  canonical = Astro.url.href,
  ogImage = '/assets/img/logo/logo.png',
  noindex = false,
} = Astro.props;
---

<!doctype html>
<html class="no-js" lang="es">
<head>
  <ClientRouter />
  <meta charset="utf-8">
  <meta http-equiv="x-ua-compatible" content="ie=edge">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
  {noindex && <meta name="robots" content="noindex, nofollow">}

  <!-- Canonical -->
  <link rel="canonical" href={canonical}>

  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:url" content={canonical}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={ogImage}>
  <meta property="og:locale" content="es_MX">

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={ogImage}>

  <link rel="icon" type="image/svg+xml" href="/assets/img/logo/favicon.svg">
  
  <!-- CSS global -->
  <link href="/assets/css/bootstrap.min.css" rel="stylesheet" />
  <link href="/assets/css/fontawesome.min.css" rel="stylesheet" />
  <link href="/assets/css/magnific-popup.css" rel="stylesheet" />
  <link href="/assets/css/owl.carousel.min.css" rel="stylesheet" />
  <link href="/assets/css/owl.theme.default.min.css" rel="stylesheet" />
  <link href="/assets/css/animate.css" rel="stylesheet" />
  <link href="/assets/css/themify-icons.css" rel="stylesheet" />
  <link href="/assets/css/icofont.min.css" rel="stylesheet" />
  <link href="/assets/css/site-flaticon.css" rel="stylesheet" />
  <link href="/style.css" rel="stylesheet">
  <link href="/assets/css/responsive.css" rel="stylesheet" />
</head>
<body id="bdy">
  
  <Header />
  
  <main class="main">
    <slot />  <!-- Aquí se inyectará el contenido de cada página -->
  </main>
  
  <Footer />
  
  <a href="#bdy" id="scrtop" class="smooth-menu"><i class="ti-arrow-up"></i></a>
  
  
  <script is:inline src="/assets/js/jquery-3.6.0.min.js"></script>
  <script is:inline src="/assets/js/popper.min.js"></script>
  <script is:inline src="/assets/js/bootstrap.min.js"></script>
  <script is:inline src="/assets/js/bootstrap-menu.js"></script>
  <script is:inline src="/assets/js/jquery.easing.min.js"></script>
  <script is:inline src="/assets/js/jquery.appear.js"></script>
  <script is:inline src="/assets/js/modernizr.custom.13711.js"></script>
  <script is:inline src="/assets/js/owl.carousel.min.js"></script>
  <script is:inline src="/assets/js/jquery.magnific-popup.min.js"></script>
  <script is:inline src="/assets/js/isotope.pkgd.min.js"></script>
  <script is:inline src="/assets/js/imagesloaded.pkgd.min.js"></script>
  <script is:inline src="/assets/js/wow.min.js"></script>
  <script is:inline src="/assets/js/wodry.min.js"></script>
  <script is:inline src="/assets/js/count-to.js"></script>
  <script is:inline src="/assets/js/progress-bar.min.js"></script>
  <script is:inline src="/assets/js/color-option.js"></script>
  <script is:inline src="/assets/js/typed.js"></script>
  <script is:inline src="/assets/js/YTPlayer.min.js"></script>
  <script is:inline src="/assets/js/jquery.mixitup.min.js"></script>
  <script is:inline src="/assets/js/active-class.js"></script>
  <script is:inline src="/assets/js/main.js"></script>
</body>
</html>