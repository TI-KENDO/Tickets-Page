---

---

<!-- Carga de Bootstrap Icons y CSS de la anatomía del ticket -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
<link href="/assets/css/anatomy.css" rel="stylesheet" />

<div class="anatomy-section">
    <div class="page">
        <div class="header">
            <h1>Vive la experiencia de KendoDesk</h1>
            <h6>Anatomía del Ticket de Soporte</h6>
            <p>
                Cada sección nos ayuda a entender y resolver tu solicitud de forma más rápida y eficiente.
            </p>
        </div>

        <div class="anatomy-layout">
            <!-- LEFT CALLOUTS -->
            <div class="callouts-left">
                <div class="callout" data-target="titulo">
                    <div class="callout-header">
                        <div class="callout-num">1</div>
                        <div class="callout-title">Título del incidente</div>
                    </div>
                    <div class="callout-body">
                        Resumen claro y conciso del problema que permite priorizar la atención.
                    </div>
                </div>

                <div class="callout" data-target="categoria">
                    <div class="callout-header">
                        <div class="callout-num">2</div>
                        <div class="callout-title">Categoría interactiva</div>
                    </div>
                    <div class="callout-body">
                        Navegación multinivel por tarjetas y etiquetas (equipo, servicio, síntoma).
                    </div>
                </div>

                <div class="callout" data-target="descripcion">
                    <div class="callout-header">
                        <div class="callout-num">3</div>
                        <div class="callout-title">Descripción detallada</div>
                    </div>
                    <div class="callout-body">
                        Espacio para detallar contexto técnico, logs, pasos para reproducir o impactos.
                    </div>
                </div>

                <div class="callout" data-target="evidencia">
                    <div class="callout-header">
                        <div class="callout-num">4</div>
                        <div class="callout-title">Archivos adjuntos</div>
                    </div>
                    <div class="callout-body">
                        Permite subir capturas, documentos o archivos de soporte para mayor claridad.
                    </div>
                </div>

                <div class="callout" data-target="organizacion">
                    <div class="callout-header">
                        <div class="callout-num">5</div>
                        <div class="callout-title">Organización y Destino</div>
                    </div>
                    <div class="callout-body">
                        Muestra automáticamente la empresa y el equipo técnico asignado para resolver.
                    </div>
                </div>

                <div class="callout" data-target="acciones">
                    <div class="callout-header">
                        <div class="callout-num">6</div>
                        <div class="callout-title">Acciones</div>
                    </div>
                    <div class="callout-body">
                        Opciones para cancelar o emitir el ticket (se habilita al llenar campos clave).
                    </div>
                </div>
            </div>

            <!-- CENTER FORM -->
            <div class="form-center">
                <div class="demo-card">
                    <div class="crumbs">Tickets &nbsp;›&nbsp; <b>Registrar Nuevo Ticket</b></div>
                    <h2 class="demo-title">Registrar Nuevo Ticket</h2>

                    <div class="field-block" data-section="titulo">
                        <label class="section-label">Título del incidente<span class="req">*</span></label>
                        <input type="text" id="titulo" placeholder="Ej: Caída intermitente de pasarela de pagos" />
                    </div>

                    <div class="field-block" data-section="categoria">
                        <label class="section-label">Categoría</label>
                        <div id="categoria-area"></div>
                    </div>

                    <div class="field-block" data-section="descripcion">
                        <label class="section-label">Descripción detallada</label>
                        <textarea id="desc" maxlength="5000" placeholder="Proporciona el contexto técnico, logs, pasos de reproducción o impactos observados…"></textarea>
                        <div class="counter"><span id="charcount">0</span>/5000</div>
                    </div>

                    <div class="field-block" data-section="evidencia">
                        <label class="section-label">Archivos adjuntos</label>
                        <label class="upload" for="file-input">
                            <i class="bi bi-file-earmark"></i>
                            <span id="file-label">Haz clic para seleccionar archivos</span>
                        </label>
                        <input type="file" id="file-input" multiple style="display:none;" />
                    </div>

                    <hr class="sep" />

                    <div class="field-block" data-section="organizacion">
                        <div class="two-col">
                            <div>
                                <label class="section-label">Empresa</label>
                                <div class="readonly-field"><i class="bi bi-display"></i> Nombre de Empresa</div>
                            </div>
                            <div>
                                <label class="section-label">Equipo técnico destino</label>
                                <div class="readonly-field muted">Soporte TI</div>
                            </div>
                        </div>
                    </div>

                    <div class="field-block" data-section="acciones">
                        <div class="footer-actions">
                            <button class="btn btn-plain" type="button"><i class="bi bi-arrow-left"></i> Cancelar</button>
                            <button class="btn btn-primary" id="emitir-btn" type="button" disabled><i class="bi bi-save2"></i> Emitir Ticket</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal para emular el envío del ticket -->
<div id="ticket-modal-overlay" class="ticket-modal-overlay" aria-hidden="true">
    <div class="ticket-modal" role="dialog" aria-modal="true" aria-labelledby="modal-title">
        <button type="button" class="modal-close-btn" id="modal-close-x" aria-label="Cerrar modal">
            <i class="bi bi-x-lg"></i>
        </button>

        <!-- Estado 1: Loading / Enviando -->
        <div id="modal-loading-state" class="modal-state">
            <div class="modal-spinner-container">
                <div class="modal-spinner"></div>
                <div class="modal-spinner-icon">
                    <i class="bi bi-send-fill"></i>
                </div>
            </div>
            <h3 class="modal-loading-title">Procesando Ticket</h3>
            <p class="modal-loading-sub">Enviando la información al equipo técnico de soporte...</p>
        </div>

        <!-- Estado 2: Éxito / Ticket Emitido -->
        <div id="modal-success-state" class="modal-state" style="display: none;">
            <div class="modal-success-icon">
                <i class="bi bi-check-circle-fill"></i>
            </div>
            <h3 id="modal-title" class="modal-success-title">¡Ticket Emitido con Éxito!</h3>
            <p class="modal-success-sub">Tu solicitud ha sido registrada y asignada al área correspondiente.</p>

            <div class="ticket-summary-card">
                <div class="ticket-badge-header">
                    <span class="ticket-id" id="modal-ticket-id">#TK-00000</span>
                    <span class="ticket-status-badge"><i class="bi bi-clock-history"></i> Abierto</span>
                </div>
                <div class="ticket-detail-row">
                    <span class="detail-label">Título:</span>
                    <span class="detail-val" id="modal-ticket-title">-</span>
                </div>
                <div class="ticket-detail-row">
                    <span class="detail-label">Categoría:</span>
                    <span class="detail-val" id="modal-ticket-category">-</span>
                </div>
                <div class="ticket-detail-row">
                    <span class="detail-label">Descripción:</span>
                    <span class="detail-val description-val" id="modal-ticket-desc">-</span>
                </div>
                <div class="ticket-detail-row">
                    <span class="detail-label">Archivos:</span>
                    <span class="detail-val" id="modal-ticket-files">Ninguno</span>
                </div>
                <div class="ticket-detail-row">
                    <span class="detail-label">Destino:</span>
                    <span class="detail-val">Empresa &bull; Soporte TI</span>
                </div>
                <div class="ticket-detail-row">
                    <span class="detail-label">Fecha:</span>
                    <span class="detail-val" id="modal-ticket-date">-</span>
                </div>
            </div>

            <div class="modal-footer-actions">
                <button type="button" class="btn btn-plain" id="modal-new-ticket-btn">
                    <i class="bi bi-plus-circle"></i> Registrar otro ticket
                </button>
                <button type="button" class="btn btn-primary" id="modal-done-btn">
                    <i class="bi bi-check2"></i> Entendido
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Carga del JS extraído en los assets -->
<script src="/assets/js/anatomy.js" is:inline></script>
