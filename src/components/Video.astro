---
import { Image, getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import defaultPoster from "../assets/img/dashboard/dashboard.png";

export interface Props {
  title?: string;
  subtitle?: string;
  description?: string;
  videoSrc?: string;
  poster?: string | ImageMetadata;
  features?: string[];
}

const {
  title = "Conoce KendoDesk en Acción",
  subtitle = "DEMOSTRACIÓN EN VIDEO",
  description = "Descubre cómo nuestra plataforma agiliza la gestión de incidencias, automatiza asignaciones y mejora los tiempos de respuesta de tu equipo técnico.",
  videoSrc = "https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/BigBuckBunny.mp4",
  poster = defaultPoster,
  features = [
    "Gestión centralizada de incidencias",
    "Automatización de flujos y tareas",
    "Métricas y reportes en tiempo real",
  ],
} = Astro.props;

let posterUrl: string = "";
if (typeof poster === "string") {
  posterUrl = poster;
} else if (poster) {
  const opt = await getImage({ src: poster, format: "webp", width: 1200 });
  posterUrl = opt.src;
}
---

<!-- Video Showcase Section -->
<section id="video-demo" class="video-section pos-rel de-pt mb-5">
  <div class="container">
    <div class="row">
      <div class="col-xl-8 offset-xl-2">
        <div class="site-title text-center">
          {subtitle && <span class="sub-title d-block mb-2">{subtitle}</span>}
          <h2>{title}</h2>
          <p class="mb-0">{description}</p>
        </div>
      </div>
    </div>

    <div class="row justify-content-center mt-5">
      <div class="col-xl-10">
        <div class="video-wrapper pos-rel">
          <div class="video-container">
            <video
              id="kendo-demo-video"
              controls
              preload="metadata"
              poster={posterUrl}
              playsinline
              class="video-element"
            >
              <source src={videoSrc} type="video/mp4" />
              Tu navegador no soporta la reproducción de video HTML5.
            </video>

            <button
              id="video-play-btn"
              class="video-overlay-btn"
              aria-label="Reproducir video"
            >
              <span class="play-icon"><i class="icofont-ui-play"></i></span>
            </button>
          </div>
        </div>

        {
          features && features.length > 0 && (
            <div class="video-features mt-4 d-flex flex-wrap justify-content-center gap-3">
              {features.map((feat) => (
                <div class="video-feat-item">
                  <i class="icofont-check-circled me-2" />
                  <span>{feat}</span>
                </div>
              ))}
            </div>
          )
        }
      </div>
    </div>
  </div>
</section>

<style>
  .video-section {
    position: relative;
    z-index: 2;
  }

  .video-wrapper {
    background: linear-gradient(145deg, #1e293b, #0f172a);
    padding: 12px;
    border-radius: 20px;
    box-shadow:
      0 25px 50px -12px rgba(0, 0, 0, 0.25),
      0 0 0 1px rgba(255, 255, 255, 0.1);
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
  }

  .video-wrapper:hover {
    box-shadow:
      0 30px 60px -12px rgba(0, 170, 235, 0.25),
      0 0 0 1px rgba(0, 170, 235, 0.3);
  }

  .video-container {
    position: relative;
    width: 100%;
    border-radius: 12px;
    overflow: hidden;
    background-color: #000;
    aspect-ratio: 16 / 9;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .video-element {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: 12px;
  }

  .video-overlay-btn {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background-color: var(--clr-def, #00aaeb);
    color: #ffffff;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 0 0 0 rgba(0, 170, 235, 0.7);
    animation: pulse-wave 2s infinite;
  }

  .video-overlay-btn:hover {
    transform: translate(-50%, -50%) scale(1.1);
    background-color: #0090c7;
  }

  .video-overlay-btn .play-icon {
    font-size: 32px;
    margin-left: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .video-overlay-btn.playing {
    opacity: 0;
    pointer-events: none;
  }

  @keyframes pulse-wave {
    0% {
      box-shadow: 0 0 0 0 rgba(0, 170, 235, 0.7);
    }
    70% {
      box-shadow: 0 0 0 25px rgba(0, 170, 235, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(0, 170, 235, 0);
    }
  }

  .video-features {
    gap: 1.5rem;
  }

  .video-feat-item {
    background: #ffffff;
    padding: 10px 20px;
    border-radius: 30px;
    font-size: 15px;
    font-weight: 600;
    color: var(--clr-heading, #1e293b);
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
    display: flex;
    align-items: center;
    border: 1px solid #e2e8f0;
  }

  .video-feat-item i {
    color: var(--clr-def, #00aaeb);
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const video = document.getElementById(
      "kendo-demo-video",
    ) as HTMLVideoElement | null;
    const playBtn = document.getElementById("video-play-btn");

    if (video && playBtn) {
      playBtn.addEventListener("click", () => {
        if (video.paused) {
          video.play();
          playBtn.classList.add("playing");
        } else {
          video.pause();
          playBtn.classList.remove("playing");
        }
      });

      video.addEventListener("play", () => {
        playBtn.classList.add("playing");
      });

      video.addEventListener("pause", () => {
        playBtn.classList.remove("playing");
      });

      video.addEventListener("ended", () => {
        playBtn.classList.remove("playing");
      });
    }
  });
</script>
