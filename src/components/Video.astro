---
import { Image, getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import defaultPoster from "../assets/img/dashboard/dashboard.png";

export interface Props {
  title?: string;
  subtitle?: string;
  description?: string;
  videoSrc?: string;
  poster?: string | ImageMetadata;
  features?: string[];
}

const {
  title = "Conoce KenDesk en Acción",
  subtitle = "DEMOSTRACIÓN EN VIDEO",
  description = "Descubre cómo nuestra plataforma agiliza la gestión de incidencias, automatiza asignaciones y mejora los tiempos de respuesta de tu equipo técnico.",
  videoSrc = "https://youtu.be/tUtpk_xl9ns?si=MXoVTqwaD9mR3lpf",
  poster = defaultPoster,
  features = [
    "Gestión centralizada de incidencias",
    "Automatización de flujos y tareas",
    "Métricas y reportes en tiempo real",
  ],
} = Astro.props;

// Function to extract YouTube Video ID and return YouTube embed URL
function getYouTubeInfo(url: string) {
  if (!url) return { isYouTube: false, embedUrl: null, videoId: null };
  const regExp = /^.*(youtu.be\/|v\/|u\/\w\/|embed\/|watch\?v=|\&v=)([^#\&\?]*).*/;
  const match = url.match(regExp);
  if (match && match[2].length === 11) {
    const videoId = match[2];
    return {
      isYouTube: true,
      videoId,
      embedUrl: `https://www.youtube.com/embed/${videoId}`
    };
  }
  return { isYouTube: false, embedUrl: null, videoId: null };
}

const { isYouTube, embedUrl } = getYouTubeInfo(videoSrc);

let posterUrl: string = "";
if (typeof poster === "string") {
  posterUrl = poster;
} else if (poster) {
  const opt = await getImage({ src: poster, format: "webp", width: 1200 });
  posterUrl = opt.src;
}
---

<!-- Video Showcase Section -->
<section id="video-demo" class="video-section pos-rel de-pt mb-5">
  <div class="container">
    <div class="row">
      <div class="col-xl-8 offset-xl-2">
        <div class="site-title text-center">
          {subtitle && <span class="sub-title d-block mb-2">{subtitle}</span>}
          <h2>{title}</h2>
          <p class="mb-0">{description}</p>
        </div>
      </div>
    </div>

    <div class="row justify-content-center mt-5">
      <div class="col-xl-10">
        <div class="video-wrapper pos-rel">
          <div class="video-container">
            {
              isYouTube ? (
                <div class="youtube-player-wrapper" id="youtube-player-wrapper" data-embed-url={embedUrl}>
                  <iframe
                    id="kendo-youtube-iframe"
                    class="video-element"
                    src={`${embedUrl}?autoplay=0&rel=0`}
                    title={title}
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                    allowfullscreen
                  ></iframe>

                  <div class="poster-overlay" id="poster-overlay">
                    {posterUrl && <img src={posterUrl} alt={title} class="poster-img" />}
                    <button
                      id="video-play-btn"
                      class="video-overlay-btn"
                      aria-label="Reproducir video"
                    >
                      <span class="play-icon"><i class="icofont-ui-play"></i></span>
                    </button>
                  </div>
                </div>
              ) : (
                <>
                  <video
                    id="kendo-demo-video"
                    controls
                    preload="metadata"
                    poster={posterUrl}
                    playsinline
                    class="video-element"
                  >
                    <source src={videoSrc} type="video/mp4" />
                    Tu navegador no soporta la reproducción de video HTML5.
                  </video>

                  <button
                    id="video-play-btn"
                    class="video-overlay-btn"
                    aria-label="Reproducir video"
                  >
                    <span class="play-icon"><i class="icofont-ui-play"></i></span>
                  </button>
                </>
              )
            }
          </div>
        </div>

        {
          features && features.length > 0 && (
            <div class="video-features mt-4 d-flex flex-wrap justify-content-center gap-3">
              {features.map((feat) => (
                <div class="video-feat-item">
                  <i class="icofont-check-circled me-2" />
                  <span>{feat}</span>
                </div>
              ))}
            </div>
          )
        }
      </div>
    </div>
  </div>
</section>

<style>
  .video-section {
    position: relative;
    z-index: 2;
  }

  .video-wrapper {
    background: linear-gradient(145deg, #1e293b, #0f172a);
    padding: 12px;
    border-radius: 20px;
    box-shadow:
      0 25px 50px -12px rgba(0, 0, 0, 0.25),
      0 0 0 1px rgba(255, 255, 255, 0.1);
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
  }

  .video-wrapper:hover {
    box-shadow:
      0 30px 60px -12px rgba(0, 170, 235, 0.25),
      0 0 0 1px rgba(0, 170, 235, 0.3);
  }

  .video-container {
    position: relative;
    width: 100%;
    border-radius: 12px;
    overflow: hidden;
    background-color: #000;
    aspect-ratio: 16 / 9;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .youtube-player-wrapper {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .poster-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 5;
    background-color: #000;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.3s ease;
  }

  .poster-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .video-element {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: 12px;
    border: none;
  }

  .video-overlay-btn {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background-color: var(--clr-def, #00aaeb);
    color: #ffffff;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 0 0 0 rgba(0, 170, 235, 0.7);
    animation: pulse-wave 2s infinite;
  }

  .video-overlay-btn:hover {
    transform: translate(-50%, -50%) scale(1.1);
    background-color: #0090c7;
  }

  .video-overlay-btn .play-icon {
    font-size: 32px;
    margin-left: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .video-overlay-btn.playing {
    opacity: 0;
    pointer-events: none;
  }

  @keyframes pulse-wave {
    0% {
      box-shadow: 0 0 0 0 rgba(0, 170, 235, 0.7);
    }
    70% {
      box-shadow: 0 0 0 25px rgba(0, 170, 235, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(0, 170, 235, 0);
    }
  }

  .video-features {
    gap: 1.5rem;
  }

  .video-feat-item {
    background: #ffffff;
    padding: 10px 20px;
    border-radius: 30px;
    font-size: 15px;
    font-weight: 600;
    color: var(--clr-heading, #1e293b);
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
    display: flex;
    align-items: center;
    border: 1px solid #e2e8f0;
  }

  .video-feat-item i {
    color: var(--clr-def, #00aaeb);
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    // YouTube handling
    const youtubeWrapper = document.getElementById("youtube-player-wrapper");
    const iframe = document.getElementById("kendo-youtube-iframe") as HTMLIFrameElement | null;
    const posterOverlay = document.getElementById("poster-overlay");
    const playBtn = document.getElementById("video-play-btn");

    if (youtubeWrapper && iframe && posterOverlay && playBtn) {
      const embedUrl = youtubeWrapper.getAttribute("data-embed-url");
      playBtn.addEventListener("click", () => {
        if (embedUrl) {
          iframe.src = `${embedUrl}?autoplay=1&rel=0`;
          posterOverlay.style.display = "none";
        }
      });
    }

    // HTML5 Video handling
    const video = document.getElementById("kendo-demo-video") as HTMLVideoElement | null;
    if (video && playBtn && !youtubeWrapper) {
      playBtn.addEventListener("click", () => {
        if (video.paused) {
          video.play();
          playBtn.classList.add("playing");
        } else {
          video.pause();
          playBtn.classList.remove("playing");
        }
      });

      video.addEventListener("play", () => {
        playBtn.classList.add("playing");
      });

      video.addEventListener("pause", () => {
        playBtn.classList.remove("playing");
      });

      video.addEventListener("ended", () => {
        playBtn.classList.remove("playing");
      });
    }
  });
</script>

