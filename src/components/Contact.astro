---
export interface Props {
  title?: string;
  address?: string;
  phone?: string;
  email?: string;
  formAction?: string;
}

const {
  title = "¿Buscas agilizar el soporte y la atención de tus usuarios?",
  phone = "(55) 1328-7995",
  email = "ventas@tikendo.com.mx",
  formAction = "/api/contact",
} = Astro.props;
---

<!-- Contact Section -->
<div id="contact" class="contact-us pos-rel de-pt">
  <div class="con-shape">
    <img src="/assets/img/shape/line-shape-2.png" alt="thumb" />
  </div>
  <div class="container">
    <div class="contact-us-wpr">
      <div class="row g-5">
        <div class="col-xl-6 col-lg-6">
          <div class="contact-content">
            <div class="contact-bottom">
              <h2 class="site-heading mb-40">{title}</h2>
              <div class="addr-box">
                
                <div class="addr-box-single">
                  <div class="addr-icon">
                    <i class="flaticon-call"></i>
                  </div>
                  <div class="addr-desc">
                    <h5>Llámanos</h5>
                    <p class="mb-0">{phone}</p>
                  </div>
                </div>
                <div class="addr-box-single">
                  <div class="addr-icon">
                    <i class="flaticon-envelope"></i>
                  </div>
                  <div class="addr-desc">
                    <h5>Envíanos un correo a</h5>
                    <p class="mb-0">{email}</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="col-xl-6 col-lg-6">
          <form class="contact-form" method="post" action={formAction} data-astro-reload>
            <div class="row">
              <div class="col-md-6">
                <div class="form-group">
                  <input
                    type="text"
                    class="form-control input-style-2"
                    name="fname"
                    placeholder="Coloca tu nombre completo*"
                    required
                  />
                  <span class="alert alert-error"></span>
                </div>
              </div>
              <div class="col-md-6">
                <div class="form-group">
                  <input
                    type="email"
                    class="form-control input-style-2"
                    name="email"
                    placeholder="Coloca tu correo empresarial*"
                    autocomplete="email"
                    required
                  />
                  <span class="alert alert-error"></span>
                </div>
              </div>
              <div class="col-md-6">
                <div class="form-group">
                  <input
                    type="tel"
                    inputmode="tel"
                    autocomplete="tel"
                    maxlength="20"
                    class="form-control input-style-2"
                    name="phone"
                    placeholder="Teléfono (10 dígitos)*"
                    required
                  />
                  <span class="alert alert-error"></span>
                </div>
              </div>
              <div class="col-md-6">
                <div class="form-group">
                  <input
                    type="text"
                    class="form-control input-style-2"
                    name="company"
                    placeholder="Nombre de la empresa*"
                    required
                    autocomplete="organization"
                  />
                  <span class="alert alert-error"></span>
                </div>
              </div>
              <div class="col-md-12">
                <div class="form-group">
                  <input
                    type="text"
                    class="form-control input-style-2"
                    name="subject"
                    placeholder="Asunto*"
                    required
                  />
                  <span class="alert alert-error"></span>
                </div>
              </div>
              <div class="col-md-12">
                <textarea
                  class="form-control input-style-2"
                  name="message"
                  placeholder="Coloca tu mensaje*"
                  required></textarea>
                <div class="contact-sub-btn text-center">
                  <button type="submit" name="submit" id="submit" class="btn-4">
                    Enviar mensaje
                    <i class="fas fa-chevron-right"></i>
                  </button>
                </div>
                <div class="alert-notification">
                  <div id="message" class="alert-msg"></div>
                </div>
              </div>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import { navigate } from "astro:transitions/client";
  import { normalizePhoneMX, PHONE_MX_ERROR } from "../lib/phone-mx";
  import { EMAIL_EMPRESARIAL_ERROR, isBusinessEmail, isValidEmail } from "../lib/email-empresarial";

  // Con <ClientRouter /> este script solo se ejecuta una vez; astro:page-load se dispara
  // en la carga inicial y tras cada navegación, así cada formulario nuevo queda conectado.
  document.addEventListener("astro:page-load", () => {
    document.querySelectorAll<HTMLFormElement>(".contact-form").forEach((form) => {
      // Error devuelto por la API en un envío sin JavaScript (?error=...): mostrarlo en el formulario.
      const params = new URLSearchParams(location.search);
      const serverError = params.get("error");
      const messageBoxInit = form.querySelector<HTMLDivElement>("#message");
      if (serverError && messageBoxInit) {
        messageBoxInit.textContent = serverError;
        messageBoxInit.className = "alert-msg alert-error";
        params.delete("error");
        const query = params.toString();
        history.replaceState(history.state, "", location.pathname + (query ? `?${query}` : "") + location.hash);
      }

      // Teléfono obligatorio: debe ser un número de México válido (el vacío lo cubre `required`).
      // setCustomValidity hace que el navegador bloquee el envío y muestre el mensaje.
      const phoneInput = form.querySelector<HTMLInputElement>('input[name="phone"]');
      const validatePhone = () => {
        if (!phoneInput) return;
        const value = phoneInput.value.trim();
        phoneInput.setCustomValidity(value && !normalizePhoneMX(value) ? PHONE_MX_ERROR : "");
      };
      phoneInput?.addEventListener("input", () => {
        // Solo permite dígitos, espacios, +, (, ), - y .
        const cleaned = phoneInput.value.replace(/[^\d\s()+.-]/g, "");
        if (cleaned !== phoneInput.value) phoneInput.value = cleaned;
        validatePhone();
      });
      phoneInput?.addEventListener("blur", () => {
        validatePhone();
        if (phoneInput.value.trim()) phoneInput.reportValidity();
      });

      // Correo obligatorio y empresarial: se rechazan proveedores gratuitos.
      // El formato lo valida el propio type="email"; aquí solo se añade la regla de dominio.
      const emailInput = form.querySelector<HTMLInputElement>('input[name="email"]');
      const validateEmail = () => {
        if (!emailInput) return;
        const value = emailInput.value.trim();
        emailInput.setCustomValidity(
          value && isValidEmail(value) && !isBusinessEmail(value) ? EMAIL_EMPRESARIAL_ERROR : "",
        );
      };
      emailInput?.addEventListener("input", validateEmail);
      emailInput?.addEventListener("blur", () => {
        validateEmail();
        if (emailInput.value.trim()) emailInput.reportValidity();
      });

      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        validatePhone();
        validateEmail();
        if (!form.reportValidity()) return;

        const submitBtn = form.querySelector<HTMLButtonElement>("#submit");
        const messageBox = form.querySelector<HTMLDivElement>("#message");
        if (!messageBox) return;

        submitBtn?.setAttribute("disabled", "disabled");
        messageBox.textContent = "Enviando...";
        messageBox.className = "alert-msg";

        try {
          const formData = new FormData(form);
          const payload = Object.fromEntries(formData.entries());

          const response = await fetch(form.action, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload),
          });

          const result = (await response.json()) as { ok?: boolean; error?: string };

          if (response.ok && result.ok) {
            form.reset();
            await navigate("/gracias/");
            return;
          } else {
            messageBox.textContent = result.error || "No se pudo enviar el mensaje. Intenta de nuevo.";
            messageBox.className = "alert-msg alert-error";
          }
        } catch {
          messageBox.textContent = "Error de conexión. Intenta de nuevo más tarde.";
          messageBox.className = "alert-msg alert-error";
        } finally {
          submitBtn?.removeAttribute("disabled");
        }
      });
  });
  });
</script>
