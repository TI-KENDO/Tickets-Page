---
import '../styles/AboutSection.css';

export interface TeamMember {
  name: string;
  role: string;
  avatar: string;
}

export interface Value {
  icon: string;
  title: string;
  description: string;
}

export interface Props {
  missionTitle?: string;
  missionText?: string;
  visionText?: string;
  values?: Value[];
  team?: TeamMember[];
}

const {
  missionTitle = "Transformamos la gestión de soporte en ventaja competitiva",
  missionText = "Kendodesk nació con la misión de simplificar la operación de los equipos de TI. Creemos que un buen sistema de tickets no solo reduce tiempos de respuesta: transforma la cultura de servicio de toda la organización.",
  visionText = "Ser la plataforma de helpdesk más confiable en Latinoamérica, habilitando a equipos de TI a entregar soporte de clase mundial sin importar el tamaño de su organización.",
  values = [
    {
      icon: "flaticon-support-1",
      title: "Orientación al cliente",
      description: "Cada decisión de producto parte de escuchar a nuestros usuarios y entender sus retos reales.",
    },
    {
      icon: "flaticon-shuttle",
      title: "Innovación continua",
      description: "Iteramos constantemente para anticiparnos a las necesidades del soporte moderno.",
    },
    {
      icon: "flaticon-insurance",
      title: "Confiabilidad",
      description: "Uptime de 99.9% y datos protegidos con los más altos estándares de seguridad.",
    },
    {
      icon: "flaticon-chat",
      title: "Transparencia",
      description: "Comunicación abierta con nuestros clientes en cada etapa del servicio.",
    },
  ],
  team = [
    { name: "Arturito", role: "CEO & Co-fundadora", avatar: "AR" },
    { name: "Arturito", role: "CTO & Co-fundador", avatar: "AR" },
    { name: "Arturito", role: "Head of Product", avatar: "AR" },
    { name: "Arturito", role: "Head of Customer Success", avatar: "AR" },
  ],
} = Astro.props;
---

<!-- ===================== MISIÓN / VISIÓN ===================== -->
<section id="about-mission" class="about-mission-section pos-rel de-pt de-pb">
  <div class="about-bg-blob blob-1"></div>
  <div class="about-bg-blob blob-2"></div>
  <div class="container">
    <div class="row align-items-center g-5">
      <!-- Texto -->
      <div class="col-xl-6 col-lg-6">
        <div class="about-text-wpr">
          <span class="about-badge">Quiénes somos</span>
          <h2 class="about-main-title">{missionTitle}</h2>
          <p class="about-lead">{missionText}</p>
          <div class="about-vision-box">
            <div class="about-vision-icon">
              <i class="flaticon-shuttle"></i>
            </div>
            <div>
              <h5>Nuestra Visión</h5>
              <p class="mb-0">{visionText}</p>
            </div>
          </div>
          <div class="about-cta-row">
            <a href="#contact" class="btn-4">Contáctanos</a>
            <a href="#features" class="btn-2">Ver características <i class="ti-arrow-right"></i></a>
          </div>
        </div>
      </div>
      <!-- Ilustración / Stats -->
      <div class="col-xl-6 col-lg-6">
        <div class="about-stats-wpr">
          <div class="about-stats-grid">
            <div class="about-stat-card card-blue">
              <span class="stat-number">+200</span>
              <span class="stat-label">Empresas confían en nosotros</span>
              <i class="flaticon-user stat-icon"></i>
            </div>
            <div class="about-stat-card card-teal">
              <span class="stat-number">99.9%</span>
              <span class="stat-label">Disponibilidad garantizada</span>
              <i class="flaticon-arrow-chart stat-icon"></i>
            </div>
            <div class="about-stat-card card-orange">
              <span class="stat-number">+50K</span>
              <span class="stat-label">Tickets resueltos al mes</span>
              <i class="flaticon-chat stat-icon"></i>
            </div>
            <div class="about-stat-card card-purple">
              <span class="stat-number">4.9★</span>
              <span class="stat-label">Calificación promedio</span>
              <i class="flaticon-support-1 stat-icon"></i>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ===================== VALORES ===================== -->
<section id="about-values" class="about-values-section de-pt de-pb">
  <div class="container">
    <div class="row">
      <div class="col-xl-8 offset-xl-2">
        <div class="site-title text-center">
          <h2>Nuestros valores</h2>
          <p class="mb-0">Los principios que guían cada línea de código y cada interacción con nuestros clientes.</p>
        </div>
      </div>
    </div>
    <div class="about-values-grid grid-4">
      {values.map((val) => (
        <article class="value-card">
          <div class="value-icon-wrap">
            <i class={val.icon}></i>
          </div>
          <h4>{val.title}</h4>
          <p class="mb-0">{val.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>


<!-- ===================== CTA BANNER ===================== -->
<section class="about-cta-section de-pt de-pb">
  <div class="container">
    <div class="about-cta-banner">
      <div class="about-cta-deco deco-1"></div>
      <div class="about-cta-deco deco-2"></div>
      <div class="about-cta-content">
        <h2>¿Listo para transformar tu soporte?</h2>
        <p>Empieza hoy sin tarjeta de crédito. Configura tu mesa de ayuda en minutos.</p>
        <a href="#pricing" class="tm-btn">Ver planes y precios</a>
      </div>
    </div>
  </div>
</section>


